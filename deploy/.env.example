# Copy to deploy/.env on the VPS and fill in. Never commit deploy/.env.

# Who may call the API from a browser (the demo page's site); comma-separated
DANCE_RAG_ALLOWED_ORIGINS=https://levibaruch.dev,https://www.levibaruch.dev

# Cost and abuse protection (cloud models cost ~1 cent per question)
DANCE_RAG_DAILY_BUDGET_USD=1.00
DANCE_RAG_QUESTIONS_PER_HOUR=5
DANCE_RAG_MAX_QUEUE=3

# Models (through the ollama container, signed in to Ollama Cloud)
DANCE_RAG_AGENTIC_ANSWER_MODEL=gpt-oss:120b-cloud
DANCE_RAG_AGENTIC_DECISION_MODEL=clef:cloud

# Faster answer model on the Cerebras API (optional; the decision model stays on Ollama).
# Local runs read only CEREBRAS_API_KEY from this file (dance_rag_agentic/config.py):
# DANCE_RAG_AGENTIC_ANSWER_MODEL=cerebras:gpt-oss-120b
# CEREBRAS_API_KEY=

# Optional
# OLLAMA_IMAGE=ollama/ollama:0.x.y
# RAG_MEM_LIMIT=2g
